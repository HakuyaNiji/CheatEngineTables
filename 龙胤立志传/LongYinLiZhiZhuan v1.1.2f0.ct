                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337329326</ID>
                              <Description>"如果附加词条本身就没有，不能无中生有"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337329327</ID>
                              <Description>"如果词条显示 = 0：力道，且属性 = 0，代表这个词条没生效。"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337329328</ID>
                              <Description>"词条不能重复，不然不显示"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
