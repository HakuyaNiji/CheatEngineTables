                        <CheatEntry>
                          <ID>1337327439</ID>
                          <Description>"突破效果"</Description>
                          <Options moHideChildren="1"/>
                          <ShowAsSigned>0</ShowAsSigned>
                          <Color>0000FF</Color>
                          <GroupHeader>1</GroupHeader>
                          <Address>+0</Address>
                          <Offsets>
                            <Offset>10</Offset>
                            <Offset>50</Offset>
                          </Offsets>
                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337327440</ID>
                              <Description>"如果附加词条本身就没有，不能无中生有"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327441</ID>
                              <Description>"如果词条显示 = 0：力道，且属性 = 0，代表这个词条没生效。"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327442</ID>
                              <Description>"词条不能重复，不然不显示"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327443</ID>
                              <Description>"改完词条，需要保存存档，然后重新读取存档"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327444</ID>
                              <Description>"词条组进制为10，即，第四组词条地址在第三组词条基础上+10"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327445</ID>
                              <Description>"例子：第三组词条地址为，40/48/4C。第四组地址为50/58/5C。"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
