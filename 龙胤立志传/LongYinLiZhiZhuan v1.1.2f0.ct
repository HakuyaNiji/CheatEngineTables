                            <CheatEntry>
                              <ID>1337328019</ID>
                              <Description>"淬毒属性"</Description>
                              <Options moHideChildren="1"/>
                              <GroupHeader>1</GroupHeader>
                              <CheatEntries>
                                <CheatEntry>
                                  <ID>1337328020</ID>
                                  <Description>"基础词条为固定词条，不能改，但是能改数值。附加词条可以改词条目和数值"</Description>
                                  <Color>0000FF</Color>
                                  <GroupHeader>1</GroupHeader>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>1337328021</ID>
                                  <Description>"如果附加词条本身就没有，不能无中生有"</Description>
                                  <Color>0000FF</Color>
                                  <GroupHeader>1</GroupHeader>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>1337328022</ID>
                                  <Description>"如果词条显示 = 0：力道，且属性 = 0，代表这个词条没生效。"</Description>
                                  <Color>0000FF</Color>
                                  <GroupHeader>1</GroupHeader>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>1337328023</ID>
                                  <Description>"词条不能重复，不然不显示"</Description>
                                  <Color>0000FF</Color>
                                  <GroupHeader>1</GroupHeader>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>1337328024</ID>
                                  <Description>"改完词条，需要保存存档，然后重新读取存档"</Description>
                                  <Color>0000FF</Color>
                                  <GroupHeader>1</GroupHeader>
                                </CheatEntry>
                                <CheatEntry>
                                  <ID>1337328025</ID>
                                  <Description>"淬毒"</Description>
