        <CheatEntry>
          <ID>1337323660</ID>
          <Description>"启动脚本（新，备份）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
if syntaxcheck then return end

processName = 'LongYinLiZhiZhuan.exe'
if not readInteger(processName) then
    openProcess(processName)
end
if not readInteger(processName) then
    messageDialog('请先开启游戏再进行激活~~，若已启动游戏，还是有次提示，请以管理员模式运行Cheat Engine!')
    local t = createTimer()
    t.Interval = 200
    t.OnTimer = function(t)
    t.destroy()
    memrec.Active = false
    end
end

mono_initialize()
LaunchMonoDataCollector()

if(getCEVersion() &lt; 7.5) then
   ShowMessage('Warning. CE version should be 7.5 or above')
end

ZanzhuExecuted = ZanzhuExecuted or false

function ZanzhuShow()
    if not ZanzhuExecuted then
        ZanZhu.show()
        ZanzhuExecuted = true
    end
end

function ZanzhuHide()
    if ZanzhuExecuted then
        ZanZhu.hide()
    end
end

pcall(function()
    ZanzhuShow()
end)

{$asm}
[DISABLE]

{$lua}
pcall(function()
    ZanzhuHide()
end)
{$asm}
</AssemblerScript>
