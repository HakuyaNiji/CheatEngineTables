            <CheatEntry>
              <ID>1337326162</ID>
              <Description>"私人仓库(先激活，再去开私人仓库)"</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(INJECT,GameAssembly.dll,0F 2F 40 1C 72 10 33 D2 48 8D 4D B8 E8 98) // should be unique
alloc(newmem,$1000,INJECT)
alloc(srck,20)
registersymbol(srck)
label(code)
label(return)

newmem:
cmp rax,0
je code
mov [srck],rax

code:
  comiss xmm0,[rax+1C]
  jb GameAssembly.dll+AC7ADD
  jmp return

INJECT:
  jmp newmem
  nop
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 0F 2F 40 1C 72 10

unregistersymbol(INJECT)
dealloc(newmem)
unregistersymbol(srck)
dealloc(srck)
</AssemblerScript>
