                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337326763</ID>
                              <Description>"基础词条为固定词条，不能改，但是能改数值。附加词条可以改词条目和数值"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337326764</ID>
