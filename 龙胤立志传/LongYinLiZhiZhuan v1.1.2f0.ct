            <CheatEntry>
              <ID>1337327815</ID>
              <Description>"任务列表"</Description>
              <Options moHideChildren="1"/>
              <ShowAsSigned>0</ShowAsSigned>
              <GroupHeader>1</GroupHeader>
              <Address>hero</Address>
              <Offsets>
                <Offset>10</Offset>
                <Offset>2E0</Offset>
              </Offsets>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337327816</ID>
                  <Description>"[这是说明]&gt;&gt;&gt;&gt;&gt;&gt;&gt;只做了2个，后面的自行加偏移，偏移 = 8，十六进制"</Description>
                  <Color>0000FF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337327817</ID>
                  <Description>"[这是说明]&gt;&gt;&gt;&gt;&gt;&gt;&gt;举例：任务二的偏移为28，那么任务三的偏移为28 + 8  = 30"</Description>
                  <Color>0000FF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337327818</ID>
