                        <CheatEntry>
                          <ID>1337327473</ID>
                          <Description>"装备效果"</Description>
                          <Options moHideChildren="1"/>
                          <ShowAsSigned>0</ShowAsSigned>
                          <Color>0000FF</Color>
                          <GroupHeader>1</GroupHeader>
                          <Address>+0</Address>
                          <Offsets>
                            <Offset>10</Offset>
                            <Offset>28</Offset>
                          </Offsets>
                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337327474</ID>
                              <Description>"如果附加词条本身就没有，不能无中生有"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327475</ID>
                              <Description>"如果词条显示 = 0：力道，且属性 = 0，代表这个词条没生效。"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327476</ID>
                              <Description>"词条不能重复，不然不显示"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327477</ID>
                              <Description>"改完词条，需要保存存档，然后重新读取存档"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327478</ID>
                              <Description>"词条组进制为10，即，第四组词条地址在第三组词条基础上+10"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337327479</ID>
                              <Description>"例子：第三组词条地址为，40/48/4C。第四组地址为50/58/5C。"</Description>
                              <Color>0000FF</Color>
                              <GroupHeader>1</GroupHeader>
                            </CheatEntry>
