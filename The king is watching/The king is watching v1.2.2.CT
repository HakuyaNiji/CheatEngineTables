  <CheatEntries>
    <CheatEntry>
      <ID>1470</ID>
      <Description>"收缩CE更简洁"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

function Routine(sender,force)
  local state = not(mi.Caption == '简洁模式')
  local mf = getMainForm()
  if force ~= nil then state = not force end
  mi.Caption = state and '简洁模式' or '正常模式'
  mf.Splitter1.Visible = state
  mf.Panel4.Visible    = state
  mf.Panel5.Visible    = state
end

function Compact()
  if CV_Exists then return end
  local parent = getMainForm().Menu.Items
  mi = createMenuItem(parent); parent.add(mi)
  mi.Caption = '简洁模式'
  mi.OnClick = Routine
  CV_Exists = 'yes'
end

Compact()
Routine(nil,true)

[DISABLE]
{$lua}
if not syntaxcheck then Routine(nil,false) end
</AssemblerScript>
    </CheatEntry>
