    <CheatEntry>
      <ID>70</ID>
      <Description>"资源倍率"</Description>
      <Options moHideChildren="1"/>
      <Color>8000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : The king is watching
  Version: 
  Date   : 2025-08-02
  Author : allen_wang

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
aobscanmodule(INJECT,The King is Watching.exe,48 8B 06 48 89 47 10 ?? ?? ?? ?? ?? 48 8B CD) // should be unique
alloc(newmem,$1000,INJECT)

label(code)
label(return)

label(multiple)
registerSymbol(multiple)

newmem:

mov rax,[rsi]
movq xmm14, rax
movq xmm15, [rdi+10]
cmppd xmm14, xmm15, 0x1E
ptest xmm14, xmm14
jne newmem3
mov rax,[rsi]
mov [rdi+10],rax
jmp return

newmem3:
movq xmm14, rax
movq xmm15, [rdi+10]
subsd xmm14, xmm15
ptest xmm14, xmm14
jne newmem2
mov rax,[rsi]
jne code


newmem2:
mulsd xmm14, [multiple]
addsd xmm14, xmm15
movq rax, xmm14

code:
  mov [rdi+10],rax
  jmp return

multiple:
  dq (double)600.0

INJECT:
  jmp newmem
  nop 2
return:
registersymbol(INJECT)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
INJECT:
  db 48 8B 06 48 89 47 10

unregistersymbol(*)
dealloc(*)

